{
  "name": "shrinkonauts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shrinkonauts base game — M1 runtime and Nerve Forest vertical slice",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/check-controller-bundle.ts && tsx scripts/check-pwa-bundle.ts",
    "build:site": "npm run gdd:site && npm run build",
    "check:controller-bundle": "tsx scripts/check-controller-bundle.ts",
    "check:pwa": "tsx scripts/check-pwa-bundle.ts",
    "preview:pwa": "tsx scripts/pwa-preview-server.ts --port 4174",
    "gdd:site": "tsx scripts/gdd-site.ts",
    "gdd:capture": "playwright test --project=capture",
    "gdd:smoke": "playwright test --config playwright.gallery.config.ts",
    "preview": "vite preview",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:dry-run": "wrangler deploy --dry-run -c worker/wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:controller": "vitest run tests/controller",
    "smoke": "vitest run tests/room-boot.test.ts tests/boundaries.test.ts",
    "pack:validate": "tsx scripts/pack-validate.ts",
    "pack:map": "tsx scripts/pack-map.ts",
    "pack:smoke": "tsx scripts/pack-smoke.ts",
    "art:slice": "tsx scripts/art-slice.ts",
    "art:key": "tsx scripts/art-key.ts",
    "art:atlas": "tsx scripts/art-atlas.ts",
    "art:fit": "tsx scripts/art-fit.ts",
    "art:hub": "tsx scripts/art-hub.ts",
    "art:build-player": "tsx scripts/art-build-player.ts",
    "art:pwa-icons": "tsx scripts/pwa-icons.ts",
    "smoke:e2e": "playwright test --project=smoke",
    "smoke:controller": "playwright test -c playwright.controller.config.ts",
    "smoke:pwa": "playwright test -c playwright.pwa.config.ts",
    "art:normalize": "tsx scripts/art-normalize.ts",
    "art:tile-clean": "node scripts/art-tile-clean.mjs",
    "art:variant": "tsx scripts/art-variant.ts",
    "art:remaster": "tsx scripts/art-remaster.ts",
    "audio:adopt": "tsx scripts/cueforge-adopt.ts"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "phaser": "4.2.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@playwright/test": "^1.64.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "marked": "^18.1.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^4.1.12",
    "wrangler": "4.156.0"
  }
}
