      "boot": "audio.cue.boot",
      "dialogue": "audio.cue.dialogue",
      "scan": "audio.cue.scan",
      "dash": "audio.cue.dash",
      "gate": "audio.cue.gate",
      "map": "audio.cue.map",
      "debrief": "audio.cue.debrief",
      "checkpoint": "audio.cue.checkpoint",
      "unlock": "audio.cue.unlock",
      "wrong": "audio.cue.wrong",
      "jump": "audio.cue.jump",
      "land": "audio.cue.land"
