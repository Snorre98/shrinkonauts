{
  "schemaVersion": "1.0",
  "id": "anatomy-atlas",
  "palette": {
    "bg": "#101a20",
    "bone": "#f2e8d5",
    "boneShadow": "#7a8f8a",
    "nerve": "#ffd166",
    "nerveGlow": "#fff3b0",
    "joint": "#7bdff2",
    "muscle": "#ef476f",
    "text": "#f7f3ea",
    "muted": "#9db4ad",
    "accent": "#7bdff2",
    "danger": "#ef476f"
  },
  "fonts": {
    "ui": "Inter, system-ui, sans-serif",
