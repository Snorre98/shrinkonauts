  "concepts": [
    {
      "id": "CON-1",
      "term": "Bone structure",
      "definition": "Bones are living organs with compact and spongy bone, periosteum, marrow, and a blood supply. They provide structure, protection, and leverage.",
      "relationships": [
        {
          "type": "part_of",
          "target": "CON-7"
        },
        {
          "type": "enables",
          "target": "CON-2"
        }
      ],
      "misconceptions": [
        "Bones are dead scaffolding."
      ],
      "visual": "bone-structure",
      "tags": [
        "skeletal",
        "structure"
      ]
    },
    {
      "id": "CON-2",
      "term": "Joint structure",
      "definition": "A joint connects bones; a synovial hinge joint has cartilage, synovial fluid, and ligaments. It allows controlled movement.",
      "relationships": [
        {
          "type": "part_of",
          "target": "CON-7"
        },
        {
          "type": "enables",
          "target": "CON-6"
        }
      ],
      "misconceptions": [
        "Bones move themselves."
      ],
      "visual": "joint-structure",
      "tags": [
        "skeletal",
        "movement"
      ]
    },
    {
      "id": "CON-3",
      "term": "Neuron structure",
      "definition": "A neuron has dendrites, a soma, an axon, and axon terminals. It carries electrical signals in one direction.",
      "relationships": [
        {
          "type": "part_of",
          "target": "CON-7"
        },
        {
          "type": "prerequisite_of",
          "target": "CON-4"
        }
      ],
      "misconceptions": [
        "Signals travel both ways."
      ],
      "visual": "neuron-structure",
      "tags": [
        "nervous",
        "signalling"
      ]
    },
    {
      "id": "CON-4",
      "term": "Synapse",
      "definition": "A synapse is a gap between neurons; neurotransmitters carry the signal across it.",
      "relationships": [
        {
          "type": "part_of",
          "target": "CON-7"
        },
        {
          "type": "enables",
          "target": "CON-5"
        }
      ],
      "misconceptions": [
        "Neurons touch directly."
      ],
      "visual": "synapse-gap",
      "tags": [
        "nervous",
        "signalling"
      ]
    },
    {
      "id": "CON-5",
      "term": "Sensory and motor pathways",
      "definition": "Sensory neurons carry signals from receptors to the spinal cord; motor neurons carry signals from the spinal cord to muscles.",
      "relationships": [
        {
          "type": "part_of",
          "target": "CON-7"
        },
        {
          "type": "prerequisite_of",
          "target": "CON-7"
        }
      ],
      "misconceptions": [
        "The brain is always in the loop."
      ],
      "visual": "sensory-motor-pathway",
      "tags": [
        "nervous",
        "pathway"
      ]
    },
    {
      "id": "CON-6",
      "term": "Muscle effector",
      "definition": "A muscle contracts when a motor neuron signals the neuromuscular junction. The contraction pulls a tendon and moves a bone.",
      "relationships": [
        {
          "type": "part_of",
          "target": "CON-7"
        },
        {
          "type": "example_of",
          "target": "CON-8"
        }
      ],
      "misconceptions": [
        "The muscle decides to move."
      ],
      "visual": "muscle-effector",
      "tags": [
        "muscular",
        "effector"
      ]
    },
    {
      "id": "CON-7",
      "term": "Reflex arc",
      "definition": "A reflex arc is a fast, involuntary pathway: receptor \u2192 sensory neuron \u2192 spinal cord \u2192 motor neuron \u2192 muscle. The brain is not required for the response.",
      "relationships": [
        {
          "type": "example_of",
          "target": "CON-8"
        },
        {
          "type": "requires",
          "target": "CON-5"
        }
      ],
      "misconceptions": [
        "A reflex is a conscious decision."
      ],
      "visual": "reflex-arc",
      "tags": [
        "nervous",
        "system"
      ]
    },
    {
      "id": "CON-8",
      "term": "Sensor\u2013controller\u2013actuator loop",
      "definition": "A general control loop: a sensor detects a change, a controller processes it, an actuator responds. The same pattern appears in the body and in hardware.",
      "relationships": [
        {
          "type": "same_pattern_as",
          "target": "CON-7"
        }
      ],
      "misconceptions": [
        "Biology and technology have nothing in common."
      ],
      "visual": "control-loop",
      "tags": [
        "systems",
        "transfer"
      ]
    }
  ],
  "misconceptions": [
    {
      "id": "MIS-1",
      "statement": "The brain is in the loop.",
      "whyItPersists": "Students see the brain as the boss of the nervous system.",
      "correction": "The spinal cord integrates the reflex; the brain feels it after the fact.",
      "conceptIds": [
        "CON-5",
        "CON-7"
      ],
      "addressedBy": [
        "gate-nerve-01",
        "debrief-obj-3"
      ]
    },
    {
      "id": "MIS-2",
      "statement": "The signal travels both ways.",
      "whyItPersists": "The diagram has arrows, but the direction is easy to miss.",
      "correction": "The signal enters at the dendrite and leaves at the terminal; the reflex arc is directional.",
      "conceptIds": [
        "CON-3",
        "CON-5"
      ],
      "addressedBy": [
        "gate-nerve-01",
        "dlg-neuron-01"
      ]
    },
    {
      "id": "MIS-3",
      "statement": "The muscle decides.",
      "whyItPersists": "The muscle is the visible mover.",
      "correction": "The muscle contracts only when the motor neuron signals the neuromuscular junction.",
      "conceptIds": [
        "CON-6",
        "CON-7"
      ],
      "addressedBy": [
        "gate-reflex-01",
        "dlg-muscle-01"
      ]
    },
    {
      "id": "MIS-4",
      "statement": "Bones move themselves.",
      "whyItPersists": "The skeleton looks like a mechanical frame.",
      "correction": "Muscles pull tendons, tendons pull bones, and joints allow controlled movement.",
      "conceptIds": [
        "CON-1",
        "CON-2",
        "CON-6"
      ],
      "addressedBy": [
        "gate-joint-01",
        "dlg-synoviocyte-01"
      ]
    },
    {
      "id": "MIS-5",
      "statement": "A reflex is a conscious decision.",
      "whyItPersists": "The word 'reflex' is used loosely.",
      "correction": "The reflex is a fast spinal arc; conscious feeling arrives later.",
      "conceptIds": [
        "CON-5",
        "CON-7"
      ],
      "addressedBy": [
        "debrief-obj-3",
        "gate-reflex-01"
      ]
    }
  ],
