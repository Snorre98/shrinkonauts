  "problem": {
    "statement": "Students can label a reflex-arc diagram but cannot explain why the knee jerks before the brain consciously feels it, trace the signal through the spinal cord, or predict the effect of a component failure.",
    "gap": "Label vs. explain/predict",
    "whyItMatters": "The reflex arc is a core example of a fast, involuntary control loop; memorising labels does not produce a causal model.",
    "currentAlternatives": [
      "Static textbook diagram",
      "Label-the-diagram quiz",
      "Video demonstration"
    ]
  },
